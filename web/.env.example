# PocketEngineer Web Dashboard — Environment Variables
# Copy this to .env.local and fill in your values.
# See SELF-HOSTING.md for setup instructions.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API (required — the SAM-deployed API Gateway URL)
NEXT_PUBLIC_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Cloudflare preview proxy Worker URL (optional — required if the
# backend is configured with CLOUDFLARE_* env vars). Managed workspaces
# will surface their dev servers at {worker-url}/{serverId}-{port}/
# via a single Cloudflare Worker that proxies to the per-workspace
# Cloudflare Tunnel. Leave empty to fall back to the authenticated
# /api/preview proxy for every workspace.
NEXT_PUBLIC_CLOUDFLARE_PREVIEW_WORKER_URL=

# Linear OAuth (optional — for Linear integration)
NEXT_PUBLIC_LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Slack OAuth (optional — for Slack integration)
NEXT_PUBLIC_SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
